4. Source Code
from fastapi import FastAPI
from tinydb import TinyDB
from datetime import datetime

app = FastAPI()
db = TinyDB("quake_db.json")

@app.get("/")
def home():
    return {"message": "Earthquake API Running"}

@app.post("/quake")
def add_quake(magnitude: float, location: str):
    severity = "Minor"

    if magnitude >= 5.0 and magnitude < 7.0:
        severity = "Moderate"
    elif magnitude >= 7.0:
        severity = "Severe"

    data = {
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "magnitude": magnitude,
        "location": location,
        "severity": severity
    }

    db.insert(data)

    return {
        "status": "saved",
        "data": data
    }

@app.get("/quake")
def get_quakes():
    return db.all()
